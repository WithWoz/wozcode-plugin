{
  // Bundled defaults. User entries in ~/.woz/router-config.jsonc override
  // by id/label.

  // Routing preset Claude Code dials by default.
  "claudecode": {
    "preset": "/claudecode"
  },
  "providers": [
    {
      "id": "llamacpp",
      "baseUrl": "http://localhost:8080/v1/",
      "apiKey": "empty",
      "transports": {
        "openai": {}
      }
    },
    {
      "id": "openai",
      "backend": "openai-native",
      "baseUrl": "https://api.openai.com/v1/",
      "apiKey": "${OPENAI_API_KEY}",
      // Map Claude tier slugs to OpenAI models for subagent dispatch.
      "modelMappings": [
        { "model": "*haiku*", "target": "gpt-5.4-mini" },
        { "model": "*sonnet*", "target": "gpt-5.4" },
        { "model": "*opus*", "target": "gpt-5.5" }
      ],
      "claudecode": {
        "expose": true
      },
      "transports": {
        "openai": {
          "modelConfig": {
            "apiStyle": "responses"
          }
        }
      }
    },
    {
      "id": "meta",
      "baseUrl": "https://api.meta.ai/v1/",
      "apiKey": "${META_API_KEY}",
      "modelMappings": [
        { "model": "*haiku*", "target": "muse-spark-1.1" },
        { "model": "*sonnet*", "target": "muse-spark-1.1" },
        { "model": "*opus*", "target": "muse-spark-1.1" }
      ],
      "claudecode": {
        "expose": true
      },
      "transports": {
        "openai": {
          "modelConfig": {
            "apiStyle": "responses"
          }
        }
      }
    },
    {
      // AWS Bedrock Mantle. Serves OpenAI-compatible endpoints at `/v1/` and
      // the native Anthropic Messages API at `/anthropic/`.
      "id": "bedrock-mantle",
      "backend": "bedrock-mantle",
      "baseUrl": "https://bedrock-mantle.${AWS_REGION}.api.aws/v1/",
      "awsRegion": "${AWS_REGION}",
      // "awsProfile": "default",
      "timeoutInMs": 120000,
      "transports": {
        "openai": {
          "modelConfig": {
            "$id": "bedrock-mantle-openai-model-config",
            "defaultReasoningEffort": "none",
            "minMaxCompletionTokens": 16
          }
        },
        "anthropic": {
          "baseUrl": "https://bedrock-mantle.${AWS_REGION}.api.aws/anthropic/",
          // Strip `anthropic-beta` flags the gateway doesn't accept. Stripping
          // `context-management-2025-06-27` also requires removing the matching
          // `context_management` body field.
          "requestModifications": [
            {
              "headers": [
                {
                  "type": "removeValues",
                  "name": "anthropic-beta",
                  "values": [
                    "prompt-caching-scope-2026-01-05",
                    "oauth-2025-04-20"
                    // "context-management-2025-06-27"
                  ]
                }
              ],
              "body": [
                // { "type": "remove", "path": "context_management" }
              ]
            }
          ]
        }
      }
    },
    {
      "id": "azure-foundry",
      "backend": "azure-foundry",
      "baseUrl": "https://${FOUNDRY_RESOURCE_NAME}.openai.azure.com/openai/v1/",
      "apiKey": "${FOUNDRY_PROJECT_API_KEY}",
      "timeoutInMs": 120000,
      // Map Claude tier slugs to Azure Foundry deployment names.
      "modelMappings": [
        { "model": "*haiku*", "target": "gpt-5.4-mini" },
        { "model": "*sonnet*", "target": "gpt-5.4" },
        { "model": "*opus*", "target": "gpt-5.5-1" }
      ],
      "claudecode": {
        "expose": true
      },
      "transports": {
        "openai": {
          "modelConfig": {
            "defaultReasoningEffort": "none",
            "minMaxCompletionTokens": 16
          },
          // Steer GPT-5.x toward the WozCode MCP search/edit tools instead of
          // Claude Code's Read/Glob/Grep.
          "requestModifications": [
            {
              "when": {
                "preset": ["/claudecode", "/claudecode-azure"]
              },
              "systemPrompt": [
                // Steering bullets disabled - redundant with the MCP Search/Edit tool descriptions.
                // { "type": "append", "text": "\n\n- Batch all changes for a task into ONE mcp__plugin_woz_code__Edit call's edits[] array — not one Edit call per file. Ten edits in one call beats ten calls with one edit each.\n- Search up front, then apply edits together. Don't search-edit-search-edit.\n- Combine independent searches into one mcp__plugin_woz_code__Search call (multiple file_glob_patterns or alternation in content_regex) instead of issuing them one at a time.\n- The Edit tool's \"smallest edit\" guidance is about each edit's payload size (don't regenerate untouched lines), not about the scope of work for the task. Do everything the prompt asks for in your batched Edit call." }
              ]
            }
          ]
        }
      }
    },
    {
      // ChatGPT subscription via Codex CLI OAuth. Reuses tokens stored at
      // `~/.codex/auth.json` by `codex login`.
      "id": "chatgpt",
      "backend": "chatgpt-oauth",
      "baseUrl": "https://chatgpt.com/backend-api/codex/",
      "timeoutInMs": 120000,
      // Map Claude tier slugs to gateway-accepted model slugs.
      "modelMappings": [
        { "model": "*haiku*", "target": "gpt-5.4-mini" },
        { "model": "*sonnet*", "target": "gpt-5.4" },
        { "model": "*opus*", "target": "gpt-5.5" }
      ],
      "claudecode": {
        "expose": true
      },
      "transports": {
        "openai": {
          "modelConfig": {
            "apiStyle": "responses"
          },
          // Codex CLI fingerprint: system-prompt prefix, User-Agent, cookie
          // jar, and body-field strips required by the ChatGPT-auth gateway.
          "requestModifications": [
            {
              "when": {
                "preset": ["/claudecode", "/claudecode-chatgpt"]
              },
              "systemPrompt": [{ "type": "prepend", "text": "${CODEX_CLI_SYSTEM_PROMPT_PREFIX}" }],
              "cookieJar": "cloudflare",
              "headers": [
                // Strip headers that would tell the gateway this isn't Codex CLI.
                { "type": "remove", "name": "anthropic-*" },
                { "type": "remove", "name": "x-app" },
                { "type": "remove", "name": "x-claude-code-session-id" },
                { "type": "remove", "name": "x-stainless-*" },
                { "type": "add", "name": "user-agent", "value": "codex_cli_rs/0.32.0" },
                { "type": "add", "name": "originator", "value": "codex_cli_rs" }
              ],
              "body": [
                { "type": "remove", "path": "max_tokens" },
                { "type": "remove", "path": "max_completion_tokens" },
                { "type": "remove", "path": "max_output_tokens" },
                { "type": "remove", "path": "metadata" },
                { "type": "remove", "path": "prompt_cache_retention" },
                { "type": "remove", "path": "temperature" },
                { "type": "remove", "path": "top_p" }
              ]
            }
          ]
        }
      }
    },
    {
      // Passthrough for the vanilla-codex benchmark request-log capture. No
      // apiKey/backend, so it resolves even when OPENAI_API_KEY is unset
      // (ChatGPT-login-only machines) and `/codex-passthrough` forwards the
      // inbound bearer verbatim. `${CODEX_OPENAI_BASE_URL}` lets the benchmark
      // point this at any OpenAI-wire upstream (e.g. Azure Foundry, set by the
      // codex runner from the model prefix); unset → OpenAI direct.
      "id": "codex-passthrough-apikey",
      "baseUrl": "${CODEX_OPENAI_BASE_URL:-https://api.openai.com/v1/}",
      "transports": {
        "openai": {}
      }
    },
    {
      // Passthrough to the ChatGPT backend. No apiKey/backend: the preset
      // forwards the inbound ChatGPT bearer + `chatgpt-account-id` header
      // verbatim (contrast the request-modifying `chatgpt` / chatgpt-oauth
      // provider). Selected by `/codex-passthrough`'s providerSelectors when
      // the inbound request carries `chatgpt-account-id`.
      "id": "codex-passthrough-chatgpt",
      "baseUrl": "https://chatgpt.com/backend-api/codex/",
      "transports": {
        "openai": {}
      }
    },
    {
      // Native Anthropic API. Targeted by `/claudecode` and `/anthropic`
      // presets, both of which forward inbound auth headers.
      "id": "anthropic",
      "baseUrl": "https://api.anthropic.com",
      "transports": {
        "anthropic": {}
      }
    },
    {
      // Cursor: pricing-only entry for cost lookups on Cursor transcripts.
      "id": "cursor",
      "baseUrl": "https://api.cursor.com/v1/",
      "transports": {
        "openai": {}
      }
    }
  ],
  // Catalog of canonical models. Bindings reference these via `model` to
  // inherit shared properties (driver, pricing, request modifications).
  // Pricing is auto-injected from `src/router/router-config-pricing.ts` when
  // not set inline.
  "models": [
    { "id": "moonshotai:kimi-k2.6", "driver": "moonshotai" },
    { "id": "moonshotai:kimi-k2.5", "driver": "moonshotai" },
    { "id": "meta:muse-spark-1.1" },
    { "id": "anthropic:claude-fable-5" },
    { "id": "anthropic:claude-opus-4-8" },
    { "id": "anthropic:claude-opus-4-7" },
    { "id": "anthropic:claude-opus-4-6" },
    { "id": "anthropic:claude-opus-4-5" },
    { "id": "anthropic:claude-opus-4-0" },
    { "id": "anthropic:claude-sonnet-4-6" },
    { "id": "anthropic:claude-sonnet-4-5" },
    { "id": "anthropic:claude-sonnet-4-0" },
    { "id": "anthropic:claude-haiku-4-5" },
    { "id": "anthropic:claude-haiku-3-5" },
    { "id": "cursor:composer-2-fast" },
    { "id": "cursor:composer-2" },
    { "id": "cursor:composer-1.5" },
    { "id": "openai:gpt-5.6-sol" },
    { "id": "openai:gpt-5.6-terra" },
    { "id": "openai:gpt-5.6-luna" },
    { "id": "openai:gpt-5.5" },
    { "id": "openai:gpt-5.4" },
    { "id": "openai:gpt-5.4-mini" },
    { "id": "openai:gpt-5.4-nano" },
    { "id": "openai:gpt-5.3-codex" },
    { "id": "openai:gpt-5-mini" },
    { "id": "openai:gpt-5-nano" },
    { "id": "openai:gpt-5" }
  ],
  "bindings": [
    {
      "label": "GPT 5.6 Sol (OpenAI)",
      "provider": "openai",
      "providerModel": "gpt-5.6-sol",
      "model": "openai:gpt-5.6-sol"
    },
    {
      "label": "GPT 5.6 Terra (OpenAI)",
      "provider": "openai",
      "providerModel": "gpt-5.6-terra",
      "model": "openai:gpt-5.6-terra"
    },
    {
      "label": "GPT 5.6 Luna (OpenAI)",
      "provider": "openai",
      "providerModel": "gpt-5.6-luna",
      "model": "openai:gpt-5.6-luna"
    },
    {
      "label": "GPT 5.5 (OpenAI)",
      "provider": "openai",
      "providerModel": "gpt-5.5-2026-04-23",
      "model": "openai:gpt-5.5"
    },
    {
      // ChatGPT subscription via Codex CLI OAuth. Valid model slugs come from
      // Codex CLI's catalog: gpt-5.5, gpt-5.4, gpt-5.4-mini.
      "label": "GPT 5.5 (ChatGPT)",
      "provider": "chatgpt",
      "providerModel": "gpt-5.5",
      "model": "openai:gpt-5.5",
      "transport": "openai",
      "config": {
        "apiStyle": "responses"
      }
    },
    {
      "label": "GPT 5.4 (ChatGPT)",
      "provider": "chatgpt",
      "providerModel": "gpt-5.4",
      "model": "openai:gpt-5.4",
      "transport": "openai",
      "config": {
        "apiStyle": "responses"
      }
    },
    {
      "label": "GPT 5.4 mini (ChatGPT)",
      "provider": "chatgpt",
      "providerModel": "gpt-5.4-mini",
      "model": "openai:gpt-5.4-mini",
      "transport": "openai",
      "config": {
        "apiStyle": "responses"
      }
    },
    {
      "label": "gpt-oss",
      "provider": "llamacpp",
      "providerModel": "gpt-oss"
    },
    {
      "label": "Muse Spark 1.1 (Meta)",
      "provider": "meta",
      "providerModel": "muse-spark-1.1",
      "model": "meta:muse-spark-1.1"
    },

    // ----- AWS Bedrock Mantle bindings -----
    {
      "label": "Opus 4.7 (Bedrock)",
      "provider": "bedrock-mantle",
      "transport": "anthropic",
      // Use `global.anthropic.claude-opus-4-7` for cross-region routing.
      "providerModel": "anthropic.claude-opus-4-7",
      "model": "anthropic:claude-opus-4-7"
    },
    {
      "label": "GPT-OSS 120B (Bedrock)",
      "provider": "bedrock-mantle",
      "providerModel": "openai.gpt-oss-120b",
      "transport": "openai",
      "config": {
        "apiStyle": "responses"
      }
    },
    {
      "label": "DeepSeek V3.2 (Bedrock)",
      "provider": "bedrock-mantle",
      "providerModel": "deepseek.v3.2",
      "transport": "openai",
      "config": {
        "apiStyle": "responses",
        "supportsPromptCacheConfig": false
      }
    },
    {
      "label": "Kimi K2.5 (Bedrock)",
      "provider": "bedrock-mantle",
      "providerModel": "moonshotai.kimi-k2.5",
      "model": "moonshotai:kimi-k2.5",
      "transport": "openai",
      "config": {
        // "apiStyle": "responses",
        "supportsPromptCacheConfig": false
      }
    },
    {
      "label": "MiniMax M2.1 (Bedrock)",
      "provider": "bedrock-mantle",
      "providerModel": "minimax.minimax-m2.1",
      "transport": "openai"
    },
    {
      "label": "GLM 4.7 Flash (Bedrock)",
      "provider": "bedrock-mantle",
      "providerModel": "zai.glm-4.7-flash",
      "transport": "openai"
    },
    {
      "label": "GLM 4.7 (Bedrock)",
      "provider": "bedrock-mantle",
      "providerModel": "zai.glm-4.7",
      "transport": "openai",
      "config": {
        "apiStyle": "responses"
      }
    },
    {
      "label": "GLM 4.6 (Bedrock)",
      "provider": "bedrock-mantle",
      "providerModel": "zai.glm-4.6",
      "transport": "openai"
    },
    // ----- Azure Foundry bindings -----
    {
      "label": "GPT 5.6 Sol (Azure)",
      "provider": "azure-foundry",
      "providerModel": "gpt-5.6-sol",
      "model": "openai:gpt-5.6-sol",
      "config": {
        "apiStyle": "responses"
      }
    },
    {
      "label": "GPT 5.6 Terra (Azure)",
      "provider": "azure-foundry",
      "providerModel": "gpt-5.6-terra",
      "model": "openai:gpt-5.6-terra",
      "config": {
        "apiStyle": "responses"
      }
    },
    {
      "label": "GPT 5.6 Luna (Azure)",
      "provider": "azure-foundry",
      "providerModel": "gpt-5.6-luna",
      "model": "openai:gpt-5.6-luna",
      "config": {
        "apiStyle": "responses"
      }
    },
    {
      "label": "GPT 5.5 (Azure)",
      "provider": "azure-foundry",
      "providerModel": "gpt-5.5-1",
      "model": "openai:gpt-5.5",
      "config": {
        "apiStyle": "responses"
      }
    },
    {
      "label": "GPT 5.4 (Azure)",
      "provider": "azure-foundry",
      "providerModel": "gpt-5.4",
      "model": "openai:gpt-5.4",
      "config": {
        "apiStyle": "responses"
      }
    },
    {
      "label": "GPT 5.4 mini (Azure)",
      "provider": "azure-foundry",
      "providerModel": "gpt-5.4-mini",
      "model": "openai:gpt-5.4-mini"
    },
    {
      "label": "GPT 5.4 nano (Azure)",
      "provider": "azure-foundry",
      "providerModel": "gpt-5.4-nano",
      "model": "openai:gpt-5.4-nano"
    },
    {
      "label": "DeepSeek-V3.2 (Azure)",
      "provider": "azure-foundry",
      "providerModel": "DeepSeek-V3.2-Speciale",
      "config": {
        "supportsPromptCacheConfig": false
      }
    },
    {
      "label": "Kimi K2.6 (Azure)",
      "provider": "azure-foundry",
      "providerModel": "kimi-k2.6",
      "model": "moonshotai:kimi-k2.6",
      "config": {
        "supportsPromptCacheConfig": false
      }
    },
    {
      "label": "Kimi K2.5 (Azure)",
      "provider": "azure-foundry",
      "providerModel": "kimi-k2.5",
      "model": "moonshotai:kimi-k2.5",
      "config": {
        "supportsPromptCacheConfig": false
      }
    }
    // Native Anthropic models route via catalog id lookup on the `anthropic`
    // provider — no explicit binding needed for pricing.
  ],
  // Routing presets addressable as `/router-preset<path>/v1/...`. Each preset
  // bundles a default provider plus optional name mappings.
  "routingPresets": [
    {
      // Generic Anthropic passthrough for non-Claude-Code clients.
      "path": "/anthropic",
      "defaultProvider": "anthropic",
      "passThroughAuth": true
    },
    {
      // Claude Code home base. Forwards inbound auth to api.anthropic.com.
      "path": "/claudecode",
      "defaultProvider": "anthropic",
      "passThroughAuth": true,
      "modelMappings": [
        { "model": "opus", "target": "claude-opus-4-7" },
        { "model": "sonnet", "target": "claude-sonnet-4-6" },
        { "model": "haiku", "target": "claude-haiku-4-5" }
      ]
      // "requestModifications": [
      //   {
      //     // Strip the `claude-code-guide` subagent entry from the Agent tool
      //     // description so the model doesn't try to delegate to it.
      //     "tools": [{ "type": "edit", "tool": "Agent", "search": "- claude-code-guide:${*}\n" }],
      //     // Strip the "report the issue at github.com/anthropics/claude-code"
      //     // hint from the system prompt; not actionable from the router side.
      //     "systemPrompt": [{ "type": "edit", "search": "\n${*}- To give feedback,${*}\n", "replace": "\n" }]
      //   }
      // ]
    },
    {
      // Claude Code -> ChatGPT subscription via Codex CLI OAuth.
      "path": "/claudecode-chatgpt",
      "defaultProvider": "chatgpt"
    },
    {
      // Claude Code -> Azure Foundry. Inherits tier-slug mappings from the
      // azure-foundry provider.
      "path": "/claudecode-azure",
      "defaultProvider": "azure-foundry"
    },
    {
      // OpenAI direct for the Codex CLI. Same tool-stripping and prompt
      // rewrites as /codex-azure; only the upstream provider differs.
      "path": "/codex",
      "defaultProvider": "openai",
      "requestModifications": [
        // Empty `$id`-only slot: an experiment fragment can replace it with a
        // full requestModification entry; left unfilled it is dropped on load.
        { "$id": "codex-extra-request-modification" },
        {
          "$id": "codex-tools-remove",
          "tools": [
            { "type": "remove", "name": "apply_patch" },
            { "type": "remove", "name": "view_image" }
          ]
        },
        {
          "systemPrompt": [
            // Steering bullets disabled - redundant with the MCP Search/Edit tool descriptions; the load-bearing edit rewrites below stay active (slimmed to a minimal pointer; the redundant batching/parallelize prose lives in the MCP Search/Edit tool descriptions, paid once instead of re-billed every resumed turn).
            // { "type": "append", "text": "\n\n- Batch all changes for a task into ONE mcp__plugin_woz_code__Edit call's edits[] array — not one Edit call per file. Ten edits in one call beats ten calls with one edit each.\n- Search up front, then apply edits together. Don't search-edit-search-edit.\n- Combine independent searches into one mcp__plugin_woz_code__Search call (multiple file_glob_patterns or alternation in content_regex) instead of issuing them one at a time.\n- The Edit tool's \"smallest edit\" guidance is about each edit's payload size (don't regenerate untouched lines), not about the scope of work for the task. Do everything the prompt asks for in your batched Edit call." }
            // Empty `$id`-only append slot: an experiment fragment can replace it
            // with { "type": "append", "text": ... }; dropped on load if unfilled.
            { "$id": "codex-system-prompt-append" },
            {
              "$id": "codex-edit-search-tools",
              "type": "edit",
              "search": "- When you search for text or files, you reach first for `rg`${**}- You parallelize tool calls whenever you can, especially file reads such as `cat`, `rg`, `sed`, `ls`, `${*}\n",
              "replace": "- Use mcp__plugin_woz_code__Search for all file discovery, text search, and file reads instead of shell commands such as `rg`, `grep`, `cat`, `sed`, or `ls`.\n"
            },
            {
              "$id": "codex-edit-file-edits",
              "type": "edit",
              "search": "- Use `apply_patch` for manual code edits.${**}- Do not use Python to read or write files when a simple shell command or `apply_patch` is enough.\n",
              "replace": "- Use mcp__plugin_woz_code__Edit for all file creation and code edits instead of `apply_patch`, `cat`, heredocs, or Python write tricks.\n"
            },
            {
              "$id": "codex-edit-apply-patch-doc",
              "type": "edit",
              "search": "## `apply_patch`\n${**}\nshell {\"command\":[\"apply_patch\",\"*** Begin Patch\\n*** Add File: hello.txt\\n+Hello, world!\\n*** End Patch\\n\"]}\n```"
            }
          ]
        }
      ]
    },
    {
      // Azure Foundry for the Codex CLI. Steers Codex away from built-in
      // patch/image tools and shell file-inspection commands so WozCode's MCP
      // search/edit tooling wins.
      "path": "/codex-azure",
      "defaultProvider": "azure-foundry",
      "requestModifications": [
        // Empty `$id`-only slot: fill by id to inject a requestModification
        // (e.g. a systemPrompt.append); dropped on load when left unfilled.
        { "$id": "codex-azure-extra-request-modification" },
        {
          "$id": "codex-azure-tools-remove",
          "tools": [
            { "type": "remove", "name": "apply_patch" },
            { "type": "remove", "name": "view_image" }
          ]
        },
        {
          "systemPrompt": [
            // Steering bullets disabled - redundant with the MCP Search/Edit tool descriptions; the load-bearing edit rewrites below stay active (slimmed to a minimal pointer; the redundant batching/parallelize prose lives in the MCP Search/Edit tool descriptions, paid once instead of re-billed every resumed turn).
            // { "type": "append", "text": "\n\n- Batch all changes for a task into ONE mcp__plugin_woz_code__Edit call's edits[] array — not one Edit call per file. Ten edits in one call beats ten calls with one edit each.\n- Search up front, then apply edits together. Don't search-edit-search-edit.\n- Combine independent searches into one mcp__plugin_woz_code__Search call (multiple file_glob_patterns or alternation in content_regex) instead of issuing them one at a time.\n- The Edit tool's \"smallest edit\" guidance is about each edit's payload size (don't regenerate untouched lines), not about the scope of work for the task. Do everything the prompt asks for in your batched Edit call." }
            // Empty `$id`-only append slot: an experiment fragment can replace it
            // with { "type": "append", "text": ... }; dropped on load if unfilled.
            { "$id": "codex-azure-system-prompt-append" },
            {
              "$id": "codex-azure-edit-search-tools",
              "type": "edit",
              "search": "- When you search for text or files, you reach first for `rg`${**}- You parallelize tool calls whenever you can, especially file reads such as `cat`, `rg`, `sed`, `ls`, `${*}\n",
              "replace": "- Use mcp__plugin_woz_code__Search for all file discovery, text search, and file reads instead of shell commands such as `rg`, `grep`, `cat`, `sed`, or `ls`.\n"
            },
            {
              "$id": "codex-azure-edit-file-edits",
              "type": "edit",
              "search": "- Use `apply_patch` for manual code edits.${**}- Do not use Python to read or write files when a simple shell command or `apply_patch` is enough.\n",
              "replace": "- Use mcp__plugin_woz_code__Edit for all file creation and code edits instead of `apply_patch`, `cat`, heredocs, or Python write tricks.\n"
            },
            {
              "$id": "codex-azure-edit-apply-patch-doc",
              "type": "edit",
              "search": "## `apply_patch`\n${**}\nshell {\"command\":[\"apply_patch\",\"*** Begin Patch\\n*** Add File: hello.txt\\n+Hello, world!\\n*** End Patch\\n\"]}\n```"
            }
          ]
        }
      ],
      "modelMappings": [
        // Codex CLI sends `gpt-5.5`; Foundry's deployment name is `gpt-5.5-1`.
        { "model": "gpt-5.5", "target": "gpt-5.5-1" }
      ]
    },
    {
      // Vanilla-codex benchmark request-log capture. One preset URL serves
      // both OpenAI-apikey and ChatGPT-login codex sessions: `defaultProvider`
      // handles the apikey credential, and the providerSelector swaps in the
      // ChatGPT upstream when the inbound request carries `chatgpt-account-id`.
      // `passThroughAuth` forwards whichever credential codex attached verbatim
      // (each is only valid against its own upstream). Pure passthrough — no
      // tool stripping or prompt rewrites (contrast /codex), so the captured
      // /responses traffic mirrors a vanilla codex session.
      "path": "/codex-passthrough",
      "defaultProvider": "codex-passthrough-apikey",
      "passThroughAuth": true,
      "providerSelectors": [
        { "when": { "headerPresent": "chatgpt-account-id" }, "provider": "codex-passthrough-chatgpt" }
      ]
    }
  ]
}
